{
  "permissions": {
    "allow": [
      "Bash(bash scripts/init.sh)",
      "Bash(bash scripts/check.sh)",
      "Bash(node scripts/check-architecture.mjs:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npx expo install:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-architecture.mjs\" --hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
